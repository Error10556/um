#!/bin/env bash

CONFIGDIR="$HOME/.config"
CONFIGFILE="$CONFIGDIR/umrc"

if [ ! -f "$CONFIGFILE" ]; then
    mkdir -p "$CONFIGDIR"
    echo $'UMEDITOR=vim\nECHO=1  # set empty to disable' >"$CONFIGFILE"
    UMEDITOR=vim
    ECHO=true
else
    . "$CONFIGFILE"
fi

if [ -z "$UMEDITOR" ]; then
    UMEDITOR=vim
fi

if [ "$#" = 0 ]; then
    echo "Execute \`um-edit -h\` for help"
    exit 0
fi

if [ "$1" = "--help" -o "$1" = "-h" ]; then
    cat <<EOF
um-edit: edit a bash command and run it.

== USAGE ==

\$ um-edit COMMAND

== CONFIGURATION ==

The intended way to use this script is to
1. \`chmod +x\` it;
2. put or link the script in ~/.local/bin, or /usr/local/bin, or /opt, or idk;
3. add this line to your .bashrc:
   alias um="um-edit \\"\\\$(history -p '!!')\\""`\
   # !! DO NOT COPY FROM HERE, RUN um-edit -h AND COPY ITS OUTPUT !! `
   (of course, use a relative path instead of \`um-edit\` if needed).

Now, after you've made a typo in a command, you'll be able to execute "um"
and correct the mistake. To cancel, do not edit the command or clear it.

If your favorite editor is not vim, edit your ~/.config/umrc
(default config appears after first use).
EOF
    exit 0
fi

set -e

TEMPFILE="$(mktemp)"
printf $'%s\n' "$*" >"$TEMPFILE"
"$UMEDITOR" "$TEMPFILE"
EDITED="$(cat "$TEMPFILE")"
rm -f "$TEMPFILE"
if [ -z "$EDITED" ]; then
    echo "Aborted." >&2
    exit 0
fi
if [ "$EDITED" = "$*" ]; then
    echo "Not edited - doing nothing." >&2
    exit 0
fi
if [ -n "$ECHO" ]; then
    printf $'>>> %s\n' "$EDITED"
fi
exec bash -c "$EDITED"
